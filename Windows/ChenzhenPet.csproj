<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <!-- WPF owns DPI through the manifest; Windows Forms is only used for the tray. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>ChenzhenPet</AssemblyName>
    <Version>1.3.4</Version>
    <Product>陈震桌宠</Product>
    <Company>ChenzhenPet contributors</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <Compile Remove="Tests/**" />
    <EmbeddedResource Include="../Assets/caption-bubble.png" LogicalName="Pet.caption-bubble.png" />
    <EmbeddedResource Include="../Assets/face.png" LogicalName="Pet.face.png" />
    <EmbeddedResource Include="../Assets/portraits.json" LogicalName="Pet.portraits.json" />
    <EmbeddedResource Include="../Assets/Portraits/*.png" LogicalName="Pet.Portraits.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Assets/clips.json" LogicalName="Pet.clips.json" />
    <EmbeddedResource Include="../Assets/actions.json" LogicalName="Pet.actions.json" />
    <EmbeddedResource Include="../Assets/Actions/*.png" LogicalName="Pet.Actions.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Assets/Clips/*.wav" LogicalName="Pet.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../materials/sources.json" LogicalName="Pet.sources.json" />
    <EmbeddedResource Include="AppIcon.ico" LogicalName="Pet.icon.ico" />
    <EmbeddedResource Include="../LICENSE" LogicalName="Pet.LICENSE" />
    <EmbeddedResource Include="../ASSETS_LICENSE.md" LogicalName="Pet.ASSETS_LICENSE.md" />
    <EmbeddedResource Include="../CREDITS.txt" LogicalName="Pet.CREDITS.txt" />
    <EmbeddedResource Include="../licenses/*.txt" LogicalName="Pet.licenses.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
